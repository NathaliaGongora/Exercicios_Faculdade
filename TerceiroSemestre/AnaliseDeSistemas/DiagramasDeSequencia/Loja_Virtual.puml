@startuml
hide footbox
skinparam shadowing false
skinparam sequenceMessageAlign center
autonumber
title Loja virtual — Finalizar compra
actor "Cliente" as U
boundary "Checkout" as W
control "Sistema da loja" as S
participant "Serviço de pagamento" as P
database "Banco de Dados" as BD
U -> W : Confirmar carrinho e entrega
W -> S : Solicitar finalização
S -> BD : Validar e reservar estoque\n[operação transacional]
BD --> S : Retornar resultado da reserva
alt reserva concluída
S -> S : Calcular total e frete
activate S
deactivate S
S -> BD : Criar pedido pendente
BD --> S : Retornar identificação do pedido
S -> P : Solicitar pagamento com chave idempotente
P --> S : Retornar resultado do pagamento
alt pagamento aprovado
S -> BD : Confirmar pedido e consumir reserva
BD --> S : Confirmar atualização
S --> W : Retornar confirmação da compra
W --> U : Exibir número do pedido
else pagamento recusado
S -> BD : Registrar recusa e liberar reserva
BD --> S : Confirmar atualização
S --> W : Informar recusa do pagamento
W --> U : Exibir orientação para nova tentativa
end
else estoque insuficiente
S --> W : Informar itens indisponíveis
W --> U : Solicitar revisão do carrinho
end
@enduml

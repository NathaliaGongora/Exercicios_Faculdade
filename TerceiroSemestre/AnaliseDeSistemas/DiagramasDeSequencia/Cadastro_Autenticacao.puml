@startuml
hide footbox
skinparam shadowing false
skinparam sequenceMessageAlign center
autonumber
title Cadastro e autenticação — Login com 2FA opcional
actor "Cliente" as U
boundary "Tela de login" as W
control "Autenticação" as S
participant "Serviço de notificação" as N
database "Banco de Dados" as BD
U -> W : Informar e-mail e senha
W -> S : Solicitar autenticação
S -> BD : Consultar credenciais e preferência 2FA
BD --> S : Retornar hash e configuração
S -> S : Verificar senha contra o hash
activate S
deactivate S
alt credenciais válidas
alt 2FA habilitado
S -> N : Enviar código de uso único
N -> U : Entregar código
S --> W : Solicitar código
W --> U : Exibir campo de verificação
U -> W : Informar código recebido
W -> S : Enviar código
S -> S : Validar código e validade
activate S
deactivate S
alt código válido
S -> S : Criar sessão
activate S
deactivate S
S --> W : Retornar sessão autenticada
W --> U : Exibir área autenticada
else código inválido ou expirado
S --> W : Negar acesso
W --> U : Exibir erro de verificação
end
else 2FA desabilitado
S -> S : Criar sessão
activate S
deactivate S
S --> W : Retornar sessão autenticada
W --> U : Exibir área autenticada
end
else credenciais inválidas
S --> W : Negar acesso
W --> U : Exibir mensagem de erro
end
@enduml

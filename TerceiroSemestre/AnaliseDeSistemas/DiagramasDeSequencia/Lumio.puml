@startuml
hide footbox
skinparam shadowing false
skinparam sequenceMessageAlign center
autonumber
title Lumio — Enviar e analisar conta de energia
actor "Usuário" as U
boundary "Interface Web" as W
control "Sistema Lumio" as S
control "Serviço de IA / OCR" as IA
database "Banco de Dados" as BD
U -> W : Selecionar conta em PDF
W -> S : Enviar arquivo PDF
S -> S : Validar formato e tamanho
activate S
deactivate S
alt arquivo válido
S -> IA : Solicitar extração dos dados
IA --> S : Retornar dados estruturados em JSON
S --> W : Disponibilizar dados para revisão
W --> U : Apresentar dados extraídos
opt usuário identifica divergências
U -> W : Corrigir dados extraídos
end
U -> W : Confirmar dados da conta
W -> S : Enviar dados confirmados
S -> S : Validar dados confirmados
activate S
deactivate S
alt dados consistentes
S -> BD : Salvar conta e consumo do usuário
BD --> S : Confirmar registro
S -> IA : Solicitar análise dos dados confirmados
IA --> S : Retornar análise e indicadores
S --> W : Disponibilizar resultado
W --> U : Exibir análise e indicadores
else dados inconsistentes
S --> W : Informar campos inválidos
W --> U : Solicitar correção antes de salvar
end
else arquivo inválido
S --> W : Informar erro de formato ou tamanho
W --> U : Solicitar outro arquivo
end
@enduml

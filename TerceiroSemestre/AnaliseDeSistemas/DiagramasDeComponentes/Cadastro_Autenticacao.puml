@startuml
top to bottom direction
skinparam monochrome true
skinparam shadowing false
skinparam componentStyle uml2

component "Aplicação de cadastro" as app
component "Módulo de cadastro" as left
component "Módulo de autenticação" as middle
component "Módulo de consentimento" as right
component "Validação de CPF" as support_left
component "Autenticação em dois fatores" as support_right
component "Auditoria e políticas" as repo
database "Banco de dados" as db

app --> left : Cadastro
app --> middle : Acesso
app --> right : Permissões
right ..> support_right : <<use>> Segundo fator
middle ..> support_left : <<use>> Validação de acesso
support_left ..> repo
support_right ..> repo
repo ..> db

@enduml

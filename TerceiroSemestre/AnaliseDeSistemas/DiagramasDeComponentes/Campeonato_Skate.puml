@startuml
top to bottom direction
skinparam monochrome true
skinparam shadowing false
skinparam componentStyle uml2

component "Portal do campeonato" as app
component "Autenticação" as left
component "Módulo de skatistas" as middle
component "Módulo de campeonatos" as right
component "Módulo de vídeos e avaliações" as support_left
component "Módulo de ranking" as support_right
component "Serviço de dados" as repo
database "Banco de dados" as db

app --> left : Sessão
app --> middle : Perfil
app --> right : Inscrição
right ..> support_right : <<use>> Participantes
middle ..> support_left : <<use>> Dados do skatista
support_left ..> repo
support_right ..> repo
repo ..> db

@enduml

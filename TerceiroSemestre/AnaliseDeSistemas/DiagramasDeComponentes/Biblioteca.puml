@startuml
top to bottom direction
skinparam monochrome true
skinparam shadowing false
skinparam componentStyle uml2

component "Portal da biblioteca" as app
component "Autenticação de leitores" as left
component "Catálogo" as middle
component "Circulação" as right
component "Reservas e filas" as support_left
component "Devoluções e multas" as support_right
component "Serviço de acervo" as repo
database "Banco de dados" as db

app --> left : Acesso
app --> middle : Pesquisa
app --> right : Empréstimos
right ..> support_right : <<use>> Prazos
middle ..> support_left : <<use>> Disponibilidade
support_left ..> repo
support_right ..> repo
repo ..> db

@enduml

@startuml
top to bottom direction
skinparam monochrome true
skinparam shadowing false
skinparam componentStyle uml2

component "Interface Web" as app
component "Módulo de autenticação" as left
component "Módulo de usuários" as middle
component "Módulo de contas de energia" as right
component "Módulo de relatórios" as support_left
component "Módulo de análise de consumo" as support_right
component "Serviço de dados" as repo
database "Banco de dados" as db

app --> left : Autenticação
app --> middle : Usuários
app --> right : Contas
right ..> support_right : <<use>> Dados da conta
middle ..> support_left : <<use>> Dados do usuário
support_left ..> repo
support_right ..> repo
repo ..> db

@enduml

@startuml
left to right direction
skinparam packageStyle rectangle

actor "Cliente" as cliente
actor "Atendente" as atendente
actor "Gerente" as gerente
actor "Marketing" as marketing
actor "Receita Federal" as receita
actor "Serasa" as serasa
actor "Instagram" as instagram

rectangle "Cadastro e autenticação de clientes" {
  usecase "Cadastrar cliente" as cadastro
  usecase "Validar CPF" as validar
  usecase "Consultar CPF na\nReceita Federal" as consultaReceita
  usecase "Consultar situação\nno Serasa" as consultaSerasa
  usecase "Realizar login" as login
  usecase "Login com biometria" as biometria
  usecase "Login alternativo" as alternativo
  usecase "Validar código\nde dois fatores" as doisFatores
  usecase "Gerar relatórios" as relatorios
  usecase "Importar cadastro\ndo Instagram" as importar
  usecase "Verificar consentimento\nLGPD" as consentimento
  usecase "Registrar ou revogar\nconsentimento" as gerenciarConsentimento
}

atendente -- cadastro
cliente -- login
cliente -- gerenciarConsentimento
gerente -- relatorios
marketing -- importar
receita -- consultaReceita
serasa -- consultaSerasa
instagram -- importar

cadastro ..> validar : <<include>>
validar ..> consultaReceita : <<include>>
validar ..> consultaSerasa : <<include>>
biometria --|> login
alternativo --|> login
doisFatores ..> login : <<extend>>
importar ..> consentimento : <<include>>
@enduml

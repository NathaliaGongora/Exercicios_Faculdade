@startuml
left to right direction
skinparam packageStyle rectangle

actor "Usuário" as usuario
actor "Skatista" as skatista
actor "Juiz" as juiz
actor "Administrador" as adm

rectangle "Campeonato virtual de skate" {
  usecase "Realizar login" as login
  usecase "Publicar vídeo" as publicar
  usecase "Inscrever-se em\ncampeonato" as inscricao
  usecase "Votar em vídeo" as votar
  usecase "Consultar ranking" as ranking
  usecase "Participar do fórum" as forum
  usecase "Avaliar vídeo" as avaliar
  usecase "Gerenciar campeonato" as campeonato
  usecase "Analisar denúncia" as denuncia
  usecase "Excluir vídeo" as excluir
  usecase "Suspender usuário" as suspender
  usecase "Consultar relatórios" as relatorio
}

skatista --|> usuario
usuario -- login
skatista -- publicar
skatista -- inscricao
skatista -- votar
skatista -- ranking
skatista -- forum
juiz -- avaliar
juiz -- denuncia
adm -- campeonato
adm -- denuncia
adm -- relatorio

excluir ..> denuncia : <<extend>>
suspender ..> denuncia : <<extend>>
@enduml

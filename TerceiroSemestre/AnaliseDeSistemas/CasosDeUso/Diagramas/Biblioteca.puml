@startuml
left to right direction
skinparam packageStyle rectangle

actor "Leitor" as leitor
actor "Atendente" as atendente
actor "Serviço de pagamento" as pagamento

rectangle "Sistema de biblioteca" {
  usecase "Consultar catálogo" as catalogo
  usecase "Emprestar livro" as emprestar
  usecase "Verificar disponibilidade" as disponibilidade
  usecase "Reservar livro" as reservar
  usecase "Devolver livro" as devolver
  usecase "Calcular multa" as multa
  usecase "Pagar multa" as pagar
  usecase "Gerenciar acervo" as acervo
  usecase "Consultar empréstimos" as consulta
}

leitor -- catalogo
leitor -- emprestar
leitor -- reservar
leitor -- devolver
leitor -- pagar
atendente -- emprestar
atendente -- devolver
atendente -- acervo
atendente -- consulta
pagamento -- pagar

emprestar ..> disponibilidade : <<include>>
reservar ..> catalogo : <<extend>>
multa ..> devolver : <<extend>>
pagar ..> multa : <<include>>
@enduml

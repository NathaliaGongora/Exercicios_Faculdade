@startuml
left to right direction
skinparam packageStyle rectangle

actor "Cliente" as cliente
actor "Administrador" as adm
actor "Gateway de pagamento" as gateway
actor "Transportadora" as entrega

rectangle "Loja virtual" {
  usecase "Consultar produtos" as consultar
  usecase "Manter carrinho" as carrinho
  usecase "Finalizar compra" as compra
  usecase "Calcular total" as total
  usecase "Autorizar pagamento" as autorizar
  usecase "Acompanhar pedido" as acompanhar
  usecase "Atualizar entrega" as atualizar
  usecase "Gerenciar produtos" as produtos
  usecase "Solicitar cancelamento" as cancelar
}

cliente -- consultar
cliente -- carrinho
cliente -- compra
cliente -- acompanhar
cliente -- cancelar
adm -- produtos
gateway -- autorizar
entrega -- atualizar

compra ..> total : <<include>>
compra ..> autorizar : <<include>>
acompanhar ..> atualizar : <<include>>
cancelar ..> compra : <<extend>>
@enduml

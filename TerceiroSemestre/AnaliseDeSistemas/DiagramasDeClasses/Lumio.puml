@startuml
top to bottom direction
skinparam monochrome true
skinparam shadowing false

class EmpresaContratante {
  - id: int
  - nome: String
  - dominio: String
  + gerenciarUsuarios()
}

class Usuario {
  - id: int
  - nome: String
  - email: String
  - senhaHash: String
  - criadoEm: DateTime
  + autenticar(email, senha): bool
  + atualizarCadastro()
}

class RegistroInteresse {
  - id: int
  - dataManifestacao: DateTime
  - status: String
  + registrarInteresse()
  + atualizarStatus(status)
}

class Residencia {
  - id: int
  - endereco: String
  - tipo: String
  - ucDistribuidora: String
  + consultarConsumo()
  + calcularEconomia()
}

class ContaEnergia {
  - id: int
  - arquivo: String
  - mesReferencia: String
  - consumoKwh: double
  - valorTotal: double
  - grupoTarifario: String
  + extrairDados()
  + confirmarDados()
}

class Recomendacao {
  - id: int
  - tipo: String
  - titulo: String
  - descricao: String
  + gerar()
  + marcarComoVista()
}

class Meta {
  - id: int
  - kwhAlvo: double
  - anoAlvo: int
  - dataMeta: Date
  + definirAlvo(kwh)
  + consultarProgresso()
}

class Equipamento {
  - id: int
  - nome: String
  - potenciaW: double
  - fabricante: String
  - quantidade: int
  + estimarConsumo(horasPorDia): double
}

class ConsumoEstimado {
  - id: int
  - mesReferencia: String
  - horasPorDia: double
  - valorEstimado: double
  + calcular()
}

EmpresaContratante "1" -- "0..*" Usuario : administra
Usuario "1" -- "0..*" Residencia : acompanha
Usuario "1" -- "0..*" RegistroInteresse : manifesta
Residencia "1" -- "0..*" ContaEnergia : recebe
Residencia "1" -- "0..*" Recomendacao : recebe
Residencia "1" -- "0..*" Meta : define
Residencia "1" o-- "0..*" Equipamento : possui
Equipamento "1" -- "0..*" ConsumoEstimado : gera
@enduml

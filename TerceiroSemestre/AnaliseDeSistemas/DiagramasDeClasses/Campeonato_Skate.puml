@startuml
top to bottom direction
skinparam monochrome true
skinparam shadowing false

abstract class Usuario {
  - id: int
  - nome: String
  - email: String
  - senhaHash: String
  + realizarLogin(email, senha): bool
  + editarPerfil()
}

class Skatista {
  - apelido: String
  - categoria: String
  + inscreverSe(campeonato)
  + enviarVideo()
}

class Juiz {
  - registro: String
  + avaliarVideo(video, nota)
  + revisarAvaliacao(avaliacao)
}

class Administrador {
  + criarCampeonato()
  + analisarDenuncia(denuncia)
}

class Campeonato {
  - id: int
  - nome: String
  - dataInicio: Date
  - dataFim: Date
  - regulamento: String
  + abrirInscricoes()
  + publicarResultado()
}

class Inscricao {
  - id: int
  - dataInscricao: DateTime
  - status: String
  + confirmar()
  + cancelar()
}

class Video {
  - id: int
  - url: String
  - dataEnvio: DateTime
  - status: String
  + validarFormato(): bool
  + publicar()
}

class Avaliacao {
  - id: int
  - nota: double
  - observacao: String
  - dataAvaliacao: DateTime
  + registrarNota(nota)
  + solicitarRevisao()
}

class Denuncia {
  - id: int
  - motivo: String
  - status: String
  - dataAbertura: DateTime
  + registrar()
  + encerrar()
}

Usuario <|-- Skatista
Usuario <|-- Juiz
Usuario <|-- Administrador
Skatista "1" -- "0..*" Inscricao : realiza
Campeonato "1" *-- "0..*" Inscricao : recebe
Inscricao "1" -- "1" Video : apresenta
Video "1" -- "0..*" Avaliacao : recebe
Juiz "1" -- "0..*" Avaliacao : registra
Usuario "1" -- "0..*" Denuncia : abre
Administrador ..> Denuncia : analisa
@enduml
